{
  "name": "formistry",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.10.0",
  "description": "Formistry.js is a modern framework-agnostic TypeScript form validation library with validation, reporting, alerting, async checks, and input masking.",
  "author": "Arie Coetzer",
  "license": "MIT",
  "homepage": "https://github.com/ariedotcodotnz/Formistry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariedotcodotnz/Formistry.git"
  },
  "bugs": {
    "url": "https://github.com/ariedotcodotnz/Formistry/issues"
  },
  "keywords": [
    "form",
    "validation",
    "typescript",
    "framework-agnostic",
    "input-mask",
    "reporting"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "pnpm": ">=9.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "dev": "tsup --watch",
    "build": "pnpm clean && tsup",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "release": "bumpp && pnpm build && pnpm publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.0",
    "bumpp": "^10.1.0",
    "eslint": "^9.26.0",
    "lint-staged": "^15.5.2",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
